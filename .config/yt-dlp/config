--replace-in-metadata title " " "_"
--replace-in-metadata title "," "_"
--replace-in-metadata title "|" ""
--replace-in-metadata title "\?" ""
--replace-in-metadata title ":" ""
--replace-in-metadata title "❗️" ""
--replace-in-metadata title "\"" ""
--replace-in-metadata title "\/" ""
--sub-langs "uk,ru,de,en"
-N 10
-S ext,vcodec:av01:vp9.2:vp9,acodec:opus:ogg,+size
--extractor-args "youtube:player-client=default,-tv_simply"
--video-multistreams
-P /data/media/youtube
-o "%(title).50s.%(id)s.%(ext)s"
